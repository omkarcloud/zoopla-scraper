      "schema": "HousePricesSearchSchema",
      "public_path": "/house-prices/search",
      "params": [
        {
          "type": "string",
          "required": true,
          "default": null,
          "enum": null,
          "min": null,
          "max": null,
          "hint": "Required location: free text or geo slug (e.g. 'London', 'NW3', 'london/croydon'); the search routes also accept a pasted zoopla.co.uk search URL on this same param (auto-detected in the route). Passed through verbatim — the backend normalizes slugs itself.",
          "field": "LocationField",
          "default_note": null,
          "name": "location"
        },
        {
          "type": "integer",
          "required": false,
          "default": 1,
          "enum": null,
          "min": 1,
          "max": null,
          "hint": "",
          "field": "Integer",
          "default_note": null,
          "name": "page"
        }
      ],
      "test_example": {
        "location": "london/croydon"
      }
    },
