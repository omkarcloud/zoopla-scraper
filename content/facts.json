{
  "site": "zoopla",
  "module": "zoopla_scraper",
  "host": "zoopla-scraper.omkar.cloud",
  "slug": "zoopla-scraper",
  "title": "Zoopla Scraper",
  "base_url": "https://zoopla-scraper.omkar.cloud",
  "path_prefix": "/zoopla",
  "module_doc": "Zoopla UK property scraper API: search, listings, house prices, agents.\n\nEvery endpoint is backed by the self-hosted scrapers service\n(ONLY_SCRAPER=zoopla): plain curl_cffi against zoopla.co.uk + its GraphQL\nlambda, riding a patchright-harvested Cloudflare cookie identity (the browser\nonly runs to mint the identity). The scrapers service returns the final\nnormalized shape, served as-is; its 400s/404s surface through\nfetch_from_scrapers as BadRequestException/NotFoundException.\n\nCache-key parity: the id/url fields normalize URL forms to bare ids in\nzoopla_scraper/fields.py before the cached fetchers run, so a listing/branch\nURL and its bare id share one cache row.",
  "anti_bot": "Cloudflare",
  "endpoint_count": 11,
  "endpoints": [
    {
      "method": "get",
      "path": "/zoopla/locations/auto-complete",
      "function": "zoopla_locations_autocomplete",
      "docstring": "UK location suggestions for a partial query (\"manch\" -> Manchester,\nManchester City Centre...). Each suggestion carries a `geo_identifier`\nslug that the property-search and house-prices endpoints accept directly\nas `location`.",
      "schema": "AutocompleteSchema",
      "public_path": "/locations/auto-complete",
      "params": [
        {
          "type": "string",
          "required": true,
          "default": null,
          "enum": null,
          "min": null,
          "max": null,
          "hint": "",
          "field": "QueryField",
          "default_note": null,
          "name": "query"
        }
      ],
      "test_example": {
        "query": "manchester"
      }
    },
